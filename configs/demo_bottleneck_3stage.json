        {
          "name": "S3.fast",
          "service_time": {"distribution": "exponential", "mean": 6.0},
          "processing_cost": 1.2,
          "idle_cost": 0.3
        },
        {
          "name": "S3.slow",
          "service_time": {"distribution": "exponential", "mean": 9.0},
          "processing_cost": 0.8,
          "idle_cost": 0.3
        }
      ]
    }
  ],
  "arrival": {
    "distribution": "exponential",
    "mean": 12.0
